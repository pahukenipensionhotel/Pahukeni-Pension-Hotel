{
  "firestore": [
    {
      "database": "ai-studio-7a9fc655-fd3d-424a-8d92-c6f52bddf566",
      "rules": "firestore.rules"
    }
  ],
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
