rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return isAuthenticated() && (getUserData().role in roles);
    }

    function isAdmin() {
      return hasRole(['Admin', 'System Developer']);
    }

    function isStaff() {
      return hasRole(['Admin', 'Receptionist', 'Waiter', 'Barman', 'Laundry man', 'System Developer']);
    }

    function isOwner(field) {
      return isAuthenticated() && (resource.data[field] == request.auth.uid);
    }

    function willBeOwner(field) {
      return isAuthenticated() && (request.resource.data[field] == request.auth.uid);
    }

    // --- COLLECTION RULES ---

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Devices (Push Notifications)
    match /devices/{deviceId} {
      allow read: if isOwner('owner');
      allow write: if willBeOwner('owner');
    }

    // Public/Auth Readable Collections
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /menu_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isStaff() || isOwner('customer_uid');
      allow create: if willBeOwner('customer_uid');
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Laundry
    match /laundry_orders/{orderId} {
      allow read: if isStaff() || isOwner('customer_uid');
      allow create: if willBeOwner('customer_uid');
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /laundry_services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Bookings
    match /room_bookings/{bookingId} {
      allow read: if isStaff() || isOwner('guest_uid');
      allow create: if willBeOwner('guest_uid');
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /folios/{folioId} {
      allow read, write: if isStaff();
    }

    // Conference
    match /conference_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /conference_services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /conference_bookings/{bookingId} {
      allow read: if isStaff() || isOwner('client_uid');
      allow create: if willBeOwner('client_uid');
      allow update: if isStaff();
    }

    match /conference_folios/{folioId} {
      allow read, write: if isStaff();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isStaff() || isOwner('userId') || (isAuthenticated() && resource.data.role == getUserData().role);
      allow create: if isAuthenticated();
      allow update: if isOwner('userId') || isStaff();
      allow delete: if isStaff();
    }

    // System Logs
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Global Preferences
    match /global_preferences/{prefId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Expenditures
    match /expenditures/{expId} {
      allow read, write: if isStaff();
    }
  }
}
