rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      // Use get() with a check for existence to prevent rule crashes
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {"role": "Customer"};
    }

    function isAdmin() {
      let data = getUserData();
      return isAuthenticated() && (data.role == 'Admin' || data.role == 'System Developer');
    }

    function isStaff() {
      let data = getUserData();
      return isAuthenticated() && (data.role in ['Admin', 'Receptionist', 'Waiter', 'Barman', 'Laundry man', 'System Developer']);
    }

    // --- COLLECTION RULES ---

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Devices (Push Notifications)
    match /devices/{deviceId} {
      allow read, write: if isAuthenticated();
    }

    // Public/Auth Readable Collections
    match /rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    match /menu_items/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Laundry
    match /laundry_orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /laundry_services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }

    // Bookings
    match /room_bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /folios/{folioId} {
      allow read, write: if isStaff();
    }

    // Conference
    match /conference_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /conference_services/{serviceId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
    }
    match /conference_bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isStaff();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isStaff();
    }

    // System Logs
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Global Preferences
    match /global_preferences/{prefId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Expenditures
    match /expenditures/{expId} {
      allow read, write: if isAdmin() || isStaff(); // Allow staff to see summary if needed, but writes are handled by logic
    }
  }
}
